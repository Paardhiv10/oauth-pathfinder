# Claude API key for live generation (platform.claude.com). The curated library works without it.
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 (default, about $0.10 per guide) or claude-sonnet-5-5 (stronger, costs more)
ANTHROPIC_MODEL=
# Optional: require this code before generating (protects your API budget on a public demo)
ACCESS_CODE=
